# Docker Compose deployment settings. The Synthient API key belongs in the MCP
# client's secret store or environment, not in this server-side file.
PUBLISHED_HOST=127.0.0.1
PUBLISHED_PORT=3000
HOST=0.0.0.0
APP_PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=
FORWARD_CLIENT_IP=false
CORS_ENABLED=false
REQUEST_TIMEOUT_MS=15000
READ_TIMEOUT_MS=20000
WRITE_TIMEOUT_MS=20000
IDLE_TIMEOUT_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
MAX_HEADER_BYTES=32768
MAX_CONCURRENT_REQUESTS=8
MAX_CONCURRENT_PER_PRINCIPAL=2
SYNTHIENT_API_BASE_URL=https://api.synthient.com/api/v4/
SYNTHIENT_GRPC_ENDPOINT=grpc.synthient.com:443

# Keep api_key for loopback/self-hosted per-caller credentials. OAuth mode also
# requires SYNTHIENT_API_KEY, OAUTH_ISSUER_URL, OAUTH_JWKS_URL, OAUTH_AUDIENCE,
# MCP_RESOURCE_URL, and optionally OAUTH_REQUIRED_SCOPES in the process secret store.
AUTH_MODE=api_key
METRICS_ENABLED=false
LOG_LEVEL=info
LOG_FORMAT=text
